# Microsoft Entra app registration (public client, delegated sign-in).
# There is no client secret: you sign in with a Microsoft account that has
# access to the mailbox. Never commit real values; use .env.local.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# The (shared) mailbox that receives DMARC reports
DMARC_MAILBOX=dmarc@example.com

# Optional: folder to read (well-known name or folder id). Default: inbox
# DMARC_MAILBOX_FOLDER=inbox

# Optional: how many days back a fetch looks. Default: 90 (same as the cache).
# DMARC_FETCH_DAYS=90

# Optional: must match a redirect URI registered on the app.
# Default: http://localhost:3000/api/auth/callback
# AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: where the sign-in refresh token is stored (0600 file). Default shown.
# DMARC_AUTH_DIR=.cache/auth

# Optional: on-disk cache of parsed reports (plain-text JSON, files are 0600).
# Defaults shown. The dashboard needs history, so entries live 90 days.
# DMARC_CACHE_DIR=.cache/dmarc
# DMARC_CACHE_TTL_HOURS=2160
# DMARC_CACHE_MAX_ENTRIES=5000

# Optional: the email address that receives DMARC reports. If set, the
# dashboard's DNS check verifies that each domain's rua= includes it.
# DMARC_REPORT_ADDRESS=dmarc@example.com

# Optional: where reverse-DNS (PTR) lookups are cached. Default shown.
# DMARC_DNS_CACHE_DIR=.cache/dns
