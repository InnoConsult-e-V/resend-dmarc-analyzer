# Microsoft Entra (Azure AD) app registration used to read the mailbox via
# Microsoft Graph. Requires the Mail.Read *application*
# permission with admin consent, ideally limited to one mailbox with an
# Application Access Policy. Never commit real values; use .env.local or your
# host's secret store.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Mailbox that receives DMARC reports (user principal name / address)
DMARC_MAILBOX=dmarc@example.com

# Optional: folder to read (well-known name or folder id). Default: inbox
# DMARC_MAILBOX_FOLDER=inbox

# Optional: on-disk cache of parsed reports (plain-text JSON, files are 0600).
# Not persistent on serverless hosts. Defaults shown.
# DMARC_CACHE_DIR=.cache/dmarc
# DMARC_CACHE_TTL_HOURS=168
